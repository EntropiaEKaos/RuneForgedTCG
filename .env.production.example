# RuneForge 2.97 — Ranked Certification & Production Hardening — production environment
DATABASE_URL=postgresql://runeforge:CHANGE_ME@postgres:5432/runeforge
PLAYER_SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
MFA_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_32_CHAR_RANDOM_KEY
PAYMENT_ENCRYPTION_KEY=CHANGE_ME_TO_ANOTHER_32_CHAR_RANDOM_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_BOOTSTRAP_PASSWORD
ADMIN_ROLE=admin
NEXT_PUBLIC_APP_URL=https://runeforge.example.com
TRUST_PROXY=true
ALLOW_LEGACY_PLAYER_IDENTITY=false
MAX_API_BODY_BYTES=2000000
RUNEFORGE_RELEASE=2.97.0

# Ranked 2.97 balance gate is green. Set true only in a deploy pipeline that executes
# `npm run release:ranked-gate`/`npm run ranked:verify` successfully.
RANKED_RELEASE_CERTIFIED=false

# Runtime config refresh across horizontally scaled instances (250-60000 ms).
GAME_CONFIG_CACHE_TTL_MS=1000

# Asset storage: use S3/R2-compatible object storage in serverless/production.
ASSET_STORAGE_MODE=s3
ASSET_STORAGE_TIMEOUT_MS=10000
ASSET_S3_ENDPOINT=https://s3.example.com
ASSET_S3_REGION=us-east-1
ASSET_S3_BUCKET=runeforge-assets
ASSET_S3_ACCESS_KEY_ID=replace-me
ASSET_S3_SECRET_ACCESS_KEY=replace-me
ASSET_PUBLIC_BASE_URL=https://cdn.example.com

# Only for a persistent Node host with durable local disk:
# ASSET_STORAGE_MODE=local
# ALLOW_LOCAL_ASSET_STORAGE=true

# Mercado Pago credentials are configured/rotated in Admin → Studio → Mercado Pago.
# PAYMENT_ENCRYPTION_KEY encrypts those credentials at rest and must never be exposed to the browser.

# Card-art derivatives (optional tuning; defaults shown)
CARD_ART_MAX_DIMENSION=1600
CARD_ART_WEBP_QUALITY=82
CARD_ART_AVIF_QUALITY=55
